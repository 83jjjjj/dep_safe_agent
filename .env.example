# DepSafe 运行环境模板 —— 复制为 .env 后填写实际值
# 安全要求：.env 已在 .gitignore 中，禁止提交真实密钥

# ---- 模型（litellm，任意兼容 OpenAI 协议的服务均可）----
# 至少设置一个 API Key（DEPSAFE_API_KEY 最优先，其次 DEEPSEEK_API_KEY / OPENAI_API_KEY）
DEPSAFE_API_KEY=
# DEPSAFE_MODEL=deepseek/deepseek-v4-flash
# DEPSAFE_BASE_URL=          # 自定义网关地址（litellm 兼容）

# ---- GitHub（创建 PR/Issue 需要写权限）----
GITHUB_TOKEN=

# ---- Docker 代理透传（可选：容器内访问被墙站点用，WSL 宿主端口转发如 http://172.27.64.1:7890）----
# DEPSAFE_DOCKER_PROXY=
